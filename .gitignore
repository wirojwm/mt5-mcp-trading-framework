# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Python packaging
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# Test and quality-tool caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
