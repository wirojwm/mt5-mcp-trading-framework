.env
.env.*
!.env.example
secrets/
credentials/
*.key
*.pem

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Local databases and runtime state
*.db
*.sqlite
