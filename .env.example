# Copy this file to .env and fill in real values. Never commit .env.
# .env is already listed in .gitignore — do not remove that entry.

# Execution mode gates what the system is allowed to do. One of:
#   READ_ONLY       - market data + account/state reads only, no OrderExecutor constructed
#   MOCK            - fully in-memory, no network, no MT5/MCP connection at all
#   DRY_RUN         - real reads, OrderPlan built and logged, no MCP trading tool ever called
#   SHADOW          - like DRY_RUN, run continuously for extended observation
#   DEMO_EXECUTION  - real MCP trading tool calls, gated by a live demo-account check on every call
# LIVE is intentionally not a supported value in this codebase.
MT5_MCP_MODE=MOCK

# Demo account only. Never put live/real account credentials in this file or in .env.
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=

# MCP server connection. Left blank until Phase 3, when the actual MT5 MCP server
# is chosen and its tools are enumerated/classified.
MCP_SERVER_COMMAND=

LOG_LEVEL=INFO
