# Copy this file to .env and fill in real values. Never commit .env.
# .env is already listed in .gitignore — do not remove that entry.

# Execution mode gates what the system is allowed to do. One of:
#   READ_ONLY       - market data + account/state reads only, no OrderExecutor constructed
#   MOCK            - fully in-memory, no network, no MT5/MCP connection at all
#   DRY_RUN         - real reads, OrderPlan built and logged, no MCP trading tool ever called
#   SHADOW          - like DRY_RUN, run continuously for extended observation
#   DEMO_EXECUTION  - real MCP trading tool calls, gated by a live demo-account check on every call
# LIVE is intentionally not a supported value in this codebase.
MT5_MCP_MODE=MOCK

# Demo account only. Never put live/real account credentials in this file or in .env.
# Read directly by scripts/run_metatrader_mcp_stdio.py, which launches the third-party
# metatrader-mcp-server (PyPI) over stdio. That server requires all three as literal CLI
# args with no env-var fallback of its own -- the wrapper script exists specifically so
# these values never have to appear in any Claude Code MCP configuration file.
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=

# Must be exactly the literal string DEMO. A deliberate, separate opt-in gate that
# scripts/run_metatrader_mcp_stdio.py checks before it will launch the MCP server at all --
# independent of the runtime demo-account check performed once actually connected
# (mt5_adapter.safety.require_demo_account).
MT5_ACCOUNT_KIND=DEMO

# MCP server connection command, if/when a *second* MCP server or a non-stdio transport is
# introduced. Not used by scripts/run_metatrader_mcp_stdio.py, which is self-contained.
MCP_SERVER_COMMAND=

LOG_LEVEL=INFO
